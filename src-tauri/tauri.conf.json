{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "NeriPlayer",
  "version": "../package.json",
  "identifier": "moe.ouom.neriplayer.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "NeriPlayer",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 540,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 20, "y": 20 },
        "hiddenTitle": true,
        "transparent": false,
        "backgroundColor": "#101014",
        "visible": false,
        "backgroundThrottling": "disabled",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,IntensiveWakeUpThrottling --disable-background-timer-throttling --disable-pinch"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: data: blob:; media-src 'self' asset: http://asset.localhost https: data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https: ws: wss:; frame-src 'none'; object-src 'none'; base-uri 'self'",
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$RESOURCE/**",
          "$AUDIO/**",
          "$DOWNLOAD/**",
          "$DOCUMENT/**",
          "$DESKTOP/**",
          "$PICTURE/**",
          "/Volumes/**",
          "/mnt/**",
          "/media/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "dmg": {
        "background": "../packaging/macos/dmg-background.tiff",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 190 },
        "applicationFolderPosition": { "x": 480, "y": 190 }
      }
    },
    "windows": {
      "nsis": {
        "template": "../packaging/windows/nsis/installer.nsi",
        "installerHooks": "../packaging/windows/nsis/installer-ui.nsh",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese", "TradChinese", "Japanese"],
        "displayLanguageSelector": false
      }
    },
    "category": "Music",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libasound2",
          "libdbus-1-3",
          "libssl3"
        ]
      }
    }
  }
}
