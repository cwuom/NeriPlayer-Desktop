<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:NeriPlayer.UI.Converters"
             x:Class="NeriPlayer.App.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <!-- 主题 Brush -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF1A1A2E" />
        <SolidColorBrush x:Key="SidebarBrush"       Color="#FF16213E" />
        <SolidColorBrush x:Key="PlaybackBarBrush"   Color="#FF0F3460" />
        <SolidColorBrush x:Key="AppActiveBrush"     Color="#FF4287F5" />
        <conv:ActiveBrushConverter x:Key="ActiveBrushConverter" />
    </Application.Resources>

</Application>

